{
  "name": "Klip Studio",
  "short_name": "Klip",
  "description": "Free, open-source video viewer and editor. Edit like Canva, boost videos to 4K, cast to your TV.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f0e17",
  "theme_color": "#0f0e17",
  "categories": ["photo", "entertainment", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "media", "accept": ["video/*", "image/*", "audio/*"] }] }
  },
  "file_handlers": [
    { "action": "./", "accept": { "video/*": [".mp4", ".mov", ".webm", ".mkv"] } }
  ]
}
